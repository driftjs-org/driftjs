          <span>Counter.drift (DriftJS Single File Component)</span>
          <span>.drift</span>
        </div>
        <pre><code>&lt;script&gt;
  let count = 0;
  const double = derive(() => count * 2);

  function inc() &#123;
    count++;
  &#125;
&lt;/script&gt;

&lt;section class="counter"&gt;
  &lt;h2&gt;Count: &#123;count&#125; (Double: &#123;double&#125;)&lt;/h2&gt;
  &lt;button onclick=&#123;inc&#125;&gt;Increment&lt;/button&gt;

  &#64;if count &gt; 10 &#123;
    &lt;p class="milestone"&gt;Milestone reached!&lt;/p&gt;
  &#125;
&lt;/section&gt;</code></pre>
      </div>

      <div class="code-card">
        <div class="code-header">
          <span>What DriftJS Compiles Under the Hood</span>
          <span>Register VM Bytecode</span>
        </div>
        <pre><code>// Bytecode Stream (Uint32Array)
0x01, r0, "section"        // CREATE_ELEMENT
0x05, r0, "class", "counter" // SET_ATTR
0x01, r1, "h2"             // CREATE_ELEMENT
0x07, r2, fn(scope.count)  // INTERPOLATE_TEXT [PC: 6]
0x04, r1, r2               // APPEND_CHILD
0x04, r0, r1               // APPEND_CHILD
0x01, r3, "button"         // CREATE_ELEMENT
0x05, r3, "onclick", fn    // SET_ATTR (Event handler)
0x0D, r0, cond, subMod, deps // REACTIVE_IF
0x00, r0                   // RETURN</code></pre>
      </div>
    </div>
  </section>
