{
  "name": "devtools",
  "description": "Starter template for DriftJS CSR and SSR applications",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../scripts/copy-assets.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "driftjs-eslint-plugin": "workspace:*",
    "driftjs-prettier-plugin": "workspace:*",
    "driftjs-vite-plugin": "workspace:*",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "driftjs-compiler": "workspace:*",
    "driftjs-dom": "workspace:*",
    "driftjs-shared": "workspace:*"
  }
}