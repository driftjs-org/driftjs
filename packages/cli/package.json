{
  "name": "create-drift",
  "version": "0.0.16",
  "description": "Interactive CLI scaffolding tool for DriftJS register VM client and server applications.",
  "keywords": [
    "create-drift",
    "driftjs",
    "cli",
    "scaffolding",
    "starter",
    "template",
    "generator",
    "virtual-machine"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "template",
    "README.md"
  ],
  "bin": {
    "create-drift": "./bin/create-drift.js",
    "drift": "./bin/create-drift.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
