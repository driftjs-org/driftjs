{
  "name": "driftjs-prettier-plugin",
  "version": "0.0.15",
  "description": "Prettier plugin for formatting DriftJS (.drift) Single File Components.",
  "keywords": [
    "driftjs",
    "prettier",
    "prettier-plugin",
    "formatter",
    "sfc"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "driftjs-compiler": "workspace:*"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
