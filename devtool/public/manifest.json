{
  "manifest_version": 3,
  "name": "DriftJS DevTools",
  "version": "0.1.0",
  "description": "Firefox DevTools extension for DriftJS register VM reactivity engine",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  },
  "devtools_page": "devtools.html",
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": []
}
