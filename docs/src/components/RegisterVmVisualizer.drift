<script>
  let activeTab = 'interpolation';

  function setTab(tab) {
    activeTab = tab;
  }
</script>

<div class="vm-visualizer-widget">
  <div class="visualizer-header">
    <div class="visualizer-title">
      <span class="pulse-icon">⚡</span>
      <span>AOT Bytecode & Register Allocation Visualizer</span>
    </div>
    <div class="visualizer-tabs">
      <button class="tab-btn" onclick={() => setTab('interpolation')}>Interpolation</button>
      <button class="tab-btn" onclick={() => setTab('if-directive')}>&#64;if Directive</button>
      <button class="tab-btn" onclick={() => setTab('for-directive')}>&#64;for Loop</button>
    </div>
  </div>

  <div class="visualizer-body">
    @if activeTab === 'interpolation' {
      <div class="tab-content">
        <div class="code-panel">
          <div class="panel-tag">Source Code</div>
          <pre><code>&lt;h1 class="title"&gt;Hello &#123;name&#125;!&lt;/h1&gt;</code></pre>
        </div>
        <div class="bytecode-panel">
          <div class="panel-tag">Generated Bytecode</div>
          <div class="instruction-list">
            <div class="instruction-row">
              <span class="pc">0000</span>
              <span class="opcode">CREATE_ELEMENT</span>
            </div>
            <div class="instruction-row">
              <span class="pc">0003</span>
              <span class="opcode">SET_ATTR</span>
            </div>
            <div class="instruction-row highlight">
              <span class="pc">0008</span>
              <span class="opcode">INTERPOLATE_TEXT</span>
            </div>
            <div class="instruction-row">
              <span class="pc">0011</span>
              <span class="opcode">APPEND_CHILD</span>
            </div>
            <div class="instruction-row">
              <span class="pc">0014</span>
              <span class="opcode">RETURN</span>
            </div>
          </div>
        </div>
      </div>
    } @else if activeTab === 'if-directive' {
      <div class="tab-content">
        <div class="code-panel">
          <div class="panel-tag">Source Code</div>
          <pre><code>&#64;if isLoggedIn &#123;
  &lt;UserDashboard /&gt;
&#125; &#64;else &#123;
  &lt;LoginForm /&gt;
&#125;</code></pre>
        </div>
        <div class="bytecode-panel">
          <div class="panel-tag">Generated Bytecode</div>
          <div class="instruction-list">
            <div class="instruction-row highlight">
              <span class="pc">0000</span>
              <span class="opcode">REACTIVE_IF</span>
            </div>
            <div class="instruction-row">
              <span class="pc">0006</span>
              <span class="opcode">RETURN</span>
            </div>
          </div>
        </div>
      </div>
    } @else if activeTab === 'for-directive' {
      <div class="tab-content">
        <div class="code-panel">
          <div class="panel-tag">Source Code</div>
          <pre><code>&lt;ul&gt;
  &#64;for user in users key user.id &#123;
    &lt;li&gt;&#123;user.name&#125;&lt;/li&gt;
  &#125;
&lt;/ul&gt;</code></pre>
        </div>
        <div class="bytecode-panel">
          <div class="panel-tag">Generated Bytecode</div>
          <div class="instruction-list">
            <div class="instruction-row">
              <span class="pc">0000</span>
              <span class="opcode">CREATE_ELEMENT</span>
            </div>
            <div class="instruction-row highlight">
              <span class="pc">0003</span>
              <span class="opcode">REACTIVE_FOR</span>
            </div>
            <div class="instruction-row">
              <span class="pc">0011</span>
              <span class="opcode">RETURN</span>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>
