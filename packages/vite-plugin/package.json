{
  "name": "driftjs-vite-plugin",
  "version": "0.0.16",
  "description": "Vite plugin for build-time compilation of DriftJS Single File Components (.drift) into executable ESM bytecode modules.",
  "keywords": [
    "driftjs",
    "vite",
    "vite-plugin",
    "plugin",
    "sfc",
    "compiler",
    "build-tool"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "driftjs-compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": "8.3.1"
  },
  "devDependencies": {
    "driftjs-dom": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
